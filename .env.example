# Copy this file to .env. Never commit the real Discord webhook.
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME="Ptt Alertor"
DISCORD_AVATAR_URL=
# Durable Redis queue backpressure and best-effort graceful drain.
DISCORD_OUTBOX_MAX_PENDING=10000
DISCORD_OUTBOX_SHUTDOWN_DRAIN=15s

# Required for the subscription and broadcast APIs.
AUTH_USER=admin
AUTH_PW=replace-with-a-long-random-password

# Comma-separated boards that should get priority polling. Only boards with an
# active subscription are fetched; blank and unsubscribed entries are safe.
BOARD_HIGH=
# Polling is opt-in: only the exact value true starts it. Keep it off until the
# Discord broadcast smoke test succeeds.
JOBS_ENABLED=false
# The board/article checker above is the primary title/author feature. Comment
# and push-sum pollers are separate opt-ins because they perform extra PTT
# requests; leave them disabled unless those subscription types are needed.
PTT_COMMENT_JOBS_ENABLED=false
PTT_PUSHSUM_JOBS_ENABLED=false
# Exact startup repair for legacy/missing notification membership indexes.
RECONCILE_SUBSCRIPTION_INDEXES=true

# PTT protection defaults: one global request per second, one at a time.
PTT_REQUEST_INTERVAL=1s
# Persistent host-wide budgets. Values above 1800/hour or 20000/day are
# clamped; zero/invalid values use these conservative defaults.
PTT_MAX_REQUESTS_PER_HOUR=900
PTT_MAX_REQUESTS_PER_DAY=10000
# Set false only for a deliberate low-frequency diagnostic run. Individual
# signals still receive their ordinary cooldown unless the separate transport
# reset switch below is also disabled.
PTT_CIRCUIT_BREAKER_ENABLED=true
PTT_CIRCUIT_BREAKER_THRESHOLD=3
PTT_CIRCUIT_BREAKER_COOLDOWN=24h
# Set false only when intentionally testing transport resets at the ordinary
# global request cadence. Reset/EOF still end the attempt without a retry.
PTT_TRANSPORT_RESET_COOLDOWN_ENABLED=true
# Minimum start-to-start cadence for each producer cycle. These prevent a
# small subscription set from continuously saturating the global limiter.
PTT_HIGH_BOARD_CYCLE_INTERVAL=1m
PTT_BOARD_CYCLE_INTERVAL=1m
# Prefix notifications when one recovered batch spans at least this much
# article publication time. Catch-up delivery remains deterministic on retry.
PTT_DELAYED_ARTICLE_BATCH_SPAN=10m
PTT_COMMENT_CYCLE_INTERVAL=10m
PTT_PUSHSUM_CYCLE_INTERVAL=15m
# Push-sum state advances only after reaching the 48-hour/page-1 boundary.
# Hitting this cap keeps the previous state and retries next cycle.
PTT_PUSHSUM_MAX_PAGES=20
# If the saved article boundary falls outside Atom, crawl at most this many
# newest-to-oldest HTML pages. Hitting the cap keeps the cursor unchanged.
PTT_CATCHUP_MAX_PAGES=20
PTT_REQUEST_TIMEOUT=30s
PTT_API_TIMEOUT=45s
PTT_MAX_RETRIES=3
PTT_RETRY_BASE_DELAY=30s
PTT_SERVER_RETRY_BASE_DELAY=2s
PTT_FORBIDDEN_COOLDOWN=15m
PTT_USER_AGENT=Ptt-Alertor/5.0 (+https://github.com/Ptt-Alertor/ptt-alertor)

# Set true only after the operator confirms they are at least 18 years old.
PTT_OVER18=false

# Docker Compose supplies these. Change them only for a non-Compose install.
REDIS_ENDPOINT=redis
REDIS_PORT=6379
STORAGE_BACKEND=redis

# Optional web UI / diagnostics settings.
# Keep the direct HTTP listener on loopback. Use an HTTPS reverse proxy for
# remote access; do not expose HTTP Basic credentials over an untrusted link.
APP_PORT=9090
# Public base used only when the application generates one of its own links.
# Compose reads this reviewed value from .env; the parent shell cannot replace it.
APP_HOST=http://localhost:9090
S3_DOMAIN=
GOPS_ADDR=
